---
layout: base.njk
pageHero: false
ogType: article
parent:
  text: Blog
  url: /blog/
---
<article class="section post-article">
  <div class="narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><span aria-current="page">{{ title }}</span></li>
      </ol>
    </nav>
    <header class="page-hero-copy reveal" style="margin-bottom: var(--space-8);">
      <span class="eyebrow">Article</span>
      <h1 class="display">{{ title }}</h1>
      <p class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
    </header>
    <div class="prose reveal">
      {{ content | safe }}
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ (description or site.description) | dump | safe }},
  "datePublished": {{ page.date | isoDate | dump | safe }},
  "dateModified": {{ page.date | isoDate | dump | safe }},
  "image": "{{ site.url }}{{ image or site.ogImage }}",
  "url": "{{ site.url }}{{ page.url }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}" },
  "author": { "@id": "{{ site.url }}/#bharat" },
  "publisher": { "@id": "{{ site.url }}/#service" }
}
</script>
